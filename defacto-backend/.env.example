# Google Gemini API (AI Studio에서 발급받은 키를 입력하세요)
GEMINI_API_KEY=your_gemini_api_key_here
MODEL_NAME=gemini-3.6-flash

# LRSE Middleware (별도로 기동한 LRSE 서버의 주소)
LRSE_URL=http://host.docker.internal:8081
SESSION_ID=defacto_local_session
SESSION_SECRET=defacto_secret_key

# Database (Docker 내부망 통신용)
DATABASE_URL=postgresql://erp_admin:erp_password@db:5432/defacto_db