# =====================================================================
# 1. Cross-Platform Line Ending Normalization (Windows <-> Docker Linux)
# =====================================================================
* text=auto eol=lf
*.py text eol=lf
*.sh text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.ini text eol=lf
*.mako text eol=lf
*.md text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.mjs text eol=lf
*.json text eol=lf
*.css text eol=lf
Dockerfile text eol=lf

# Windows Batch / PowerShell scripts (if any)
*.bat text eol=crlf
*.ps1 text eol=crlf

# Binary files protection
*.ico binary
*.png binary
*.jpg binary
*.jpeg binary
*.mp3 binary
*.m4a binary
*.wav binary
*.pdf binary

